# Server
WHATIF_HOST=127.0.0.1
WHATIF_PORT=3020
WHATIF_DATA=./data
# Require this token on every /api call (?token=... or x-whatif-token). Empty = no auth (localhost only).
WHATIF_AUTH_TOKEN=

# Model LLM Agent: mock | openai | openrouter | google | anthropic | mistral | groq | local | agy | codex
# Astuce : pour configurer PLUSIEURS fournisseurs et APIs média simultanément sans modifier .env,
# utilise `providers.json` (voir `providers.example.json` — rechargé à chaud dans l'interface).
WHATIF_PROVIDER=mock
WHATIF_PROVIDERS_FILE=
WHATIF_BASE_URL=
WHATIF_MODEL=
WHATIF_API_KEY=

# --- Diffusion Image (Storyboard & Références) ----------------------------------------
# Drivers supportés : gflow | gemini | openai | http | mock
WHATIF_IMAGE_PROVIDER=gflow
WHATIF_IMAGE_BASE_URL=http://127.0.0.1:8006
WHATIF_IMAGE_API_KEY=
WHATIF_IMAGE_MODEL=nano2-lite
WHATIF_IMAGE_FALLBACK_MODEL=nano2.1
# multi = envoie les refs séparément (natif :8006, auto-switch vers nano2.1 si >3 refs) ; composite = 1 planche ; none = texte seul
WHATIF_IMAGE_REF_MODE=multi
WHATIF_IMAGE_MAX_REFS=10
WHATIF_GFLOW_PROFILE=

# --- Diffusion Vidéo Image-to-Video + SFX natif ---------------------------------------
# Drivers supportés : gflow | gemini | openai | http | mock
WHATIF_VIDEO_PROVIDER=gflow
WHATIF_VIDEO_BASE_URL=http://127.0.0.1:8006
WHATIF_VIDEO_API_KEY=
WHATIF_VIDEO_MODEL=omni-1.2-flash
# Résolution de base des clips générés : 360p | 720p | 1080p (360p par défaut sur gflow Omni 1.2)
WHATIF_VIDEO_RESOLUTION=360p

# --- Upscaler Anime 2D (Optionnel — Modal Real-CUGAN / Real-ESRGAN) -------------------
# Active automatiquement l'upscale en fin de `render` (ou appelable via `whatif_run { step: "upscale" }`).
WHATIF_UPSCALER_ENABLED=false
WHATIF_UPSCALER_DRIVER=modal-anime
WHATIF_UPSCALER_URL=https://bkrpulsy--anime-upscaler-t4-fastapi-app.modal.run
WHATIF_UPSCALER_API_KEY=
# Cibles : auto-uhd (4K 2160p) | auto-2k (1440p) | auto-1080p | 2x | 3x | 4x
WHATIF_UPSCALER_TARGET=auto-2k
# Modèles : real-cugan | realesr-animevideov3 | realesrgan-x2plus | realesrgan-x4plus
WHATIF_UPSCALER_MODEL=real-cugan
WHATIF_UPSCALER_DENOISE=1
# GPU Modal : L40S | A100-40GB | L4
WHATIF_UPSCALER_GPU=L40S

# --- Reviewer indépendant (audit automatique du storyboard & cohérence du récit) ------
# Active un second agent Reviewer au contexte vierge après l'étape "board" pour auditer
# la cohérence DIRECTOR.md <-> bible.json <-> shots/S*.json <-> storyboard.jpg (modèle vision conseillé).
WHATIF_REVIEWER_ENABLED=true
WHATIF_REVIEW_PROVIDER=
WHATIF_REVIEW_BASE_URL=
WHATIF_REVIEW_MODEL=
WHATIF_REVIEW_API_KEY=
# Nombre maximum d'allers-retours de correction par épisode avant de continuer vers render/master.
WHATIF_REVIEW_MAX_ROUNDS=3
WHATIF_REVIEW_MAX_TOKENS=12000

# Agent limits
WHATIF_MAX_TOKENS=24000
WHATIF_MAX_STEPS=1000
WHATIF_CONTEXT_CHARS=180000
WHATIF_APPROVAL_TIMEOUT_MS=1800000

# --- API locale "nouveau" (transcription, narration FR/EN, TTS ElevenLabs v4) -----------
# Le service sur le port 8005 ; il garde les vidéos, les prises TTS et les propositions.
WHATIF_NOUVEAU_URL=http://127.0.0.1:8005
WHATIF_NARRATION_MODEL=agy/gemini-3.8-flash-medium

# --- Approbations ---------------------------------------------------------------------
# off      : l'agent exécute toute la chaîne (source -> master) sans rien demander. Défaut.
# pipeline : il demande avant les outils qui modifient un projet (whatif_new, whatif_run, shell).
# all      : il demande pour tout outil marqué "ask".
WHATIF_APPROVALS=off
